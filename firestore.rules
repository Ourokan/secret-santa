rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function eventData(eid) {
      return get(/databases/$(database)/documents/events/$(eid)).data;
    }
    function isAdmin(eid) { return signedIn() && eventData(eid).adminUid == me(); }
    function shortStr(v, max) { return v is string && v.size() <= max; }

    // A group / exchange. The event id is a long random string, so it doubles
    // as the invite code: anyone signed in with the link can read it.
    match /events/{eid} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.adminUid == me();
      allow create: if signedIn()
        && request.resource.data.adminUid == me()
        && request.resource.data.status == 'open'
        && shortStr(request.resource.data.name, 100);
      allow update: if signedIn()
        && resource.data.adminUid == me()
        && request.resource.data.adminUid == resource.data.adminUid
        && shortStr(request.resource.data.name, 100);
      allow delete: if signedIn() && resource.data.adminUid == me();

      // One doc per person, id = their uid. Everyone in the group can see
      // who is in it and their wishlists.
      match /participants/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && me() == uid
          && eventData(eid).status == 'open'
          && shortStr(request.resource.data.displayName, 60)
          && shortStr(request.resource.data.wishlist, 2000);
        allow update: if signedIn() && me() == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'wishlist', 'viewedAt', 'viewedRound'])
          && shortStr(request.resource.data.displayName, 60)
          && shortStr(request.resource.data.wishlist, 2000);
        allow delete: if (signedIn() && me() == uid && eventData(eid).status == 'open')
          || isAdmin(eid);
      }

      // Organizer-only settings (the blacklist).
      match /admin/{doc} {
        allow read, write: if isAdmin(eid);
      }

      // Who you give to. Only you can read yours — not the organizer,
      // not anyone else. The organizer can only write/clear them.
      match /assignments/{uid} {
        allow get: if signedIn() && me() == uid;
        allow create, update, delete: if isAdmin(eid);
      }
    }

    // Per-user list of groups they've joined, for the home screen.
    match /users/{uid}/memberships/{eid} {
      allow read, write: if signedIn() && me() == uid;
    }
  }
}
