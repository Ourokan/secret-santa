rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isGuest() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function eventPath(eid) { return /databases/$(database)/documents/events/$(eid); }
    function eventData(eid) { return get(eventPath(eid)).data; }
    function isAdmin(eid) { return signedIn() && eventData(eid).adminUid == me(); }
    function claimPath(eid, pid) { return /databases/$(database)/documents/events/$(eid)/claims/$(pid); }

    // An exchange. Anyone with the share link can read the name list.
    // Only the signed-in organizer (not a guest) can create or change it.
    match /events/{eid} {
      allow get: if true;
      allow list: if signedIn() && resource.data.adminUid == me();
      allow create: if signedIn() && !isGuest()
        && request.resource.data.adminUid == me()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow update: if signedIn() && resource.data.adminUid == me()
        && request.resource.data.adminUid == resource.data.adminUid;
      allow delete: if signedIn() && resource.data.adminUid == me();

      // Organizer-only settings (the never-pair list).
      match /admin/{doc} {
        allow read, write: if isAdmin(eid);
      }

      // "Person X has opened their match." Public so the picker can grey out
      // opened names. Can be created exactly once per person per draw, and
      // only the organizer can clear it to let someone open again.
      match /claims/{pid} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == me()
          && eventData(eid).status == 'drawn'
          && request.resource.data.round == eventData(eid).drawRound;
        allow delete: if isAdmin(eid);
      }

      // Who each person gives to. Readable by the organizer (to resend) and by
      // whoever claimed that person, from the device that claimed it.
      match /matches/{pid} {
        allow get: if isAdmin(eid)
          || (signedIn() && exists(claimPath(eid, pid)) && get(claimPath(eid, pid)).data.uid == me());
        allow list, create, update, delete: if isAdmin(eid);
      }
    }
  }
}
